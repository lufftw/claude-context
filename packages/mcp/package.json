{
    "name": "@zilliz/claude-context-mcp",
    "version": "0.1.4-lufftw.3",
    "description": "Model Context Protocol integration for Claude Context (lufftw fork: private+shared collections, CLAUDE_CONTEXT_HOME, dual-write)",
    "type": "module",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "bin": "dist/index.js",
    "scripts": {
        "build": "pnpm clean && tsc --build --force",
        "dev": "tsx --watch src/index.ts",
        "clean": "rimraf dist",
        "lint": "eslint src --ext .ts",
        "lint:fix": "eslint src --ext .ts --fix",
        "typecheck": "tsc --noEmit",
        "test:ledger": "pnpm build && node scripts/snapshot-ledger.test.mjs",
        "test:snapshot-additive": "pnpm build && node scripts/snapshot-additive-roundtrip.test.mjs",
        "test:dual-config": "pnpm build && node scripts/dual-config-smoke.mjs",
        "test:coverage-snap": "pnpm build && node scripts/snapshot-coverage.test.mjs",
        "test:search-routing": "pnpm build && node scripts/search-model-routing.test.mjs",
        "start": "tsx src/index.ts",
        "start:with-env": "OPENAI_API_KEY=${OPENAI_API_KEY:your-api-key-here} MILVUS_ADDRESS=${MILVUS_ADDRESS:localhost:19530} tsx src/index.ts",
        "prepublishOnly": "pnpm build"
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.12.1",
        "@zilliz/claude-context-core": "workspace:*",
        "proper-lockfile": "^4.1.2",
        "zod": "^3.25.55"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/proper-lockfile": "^4.1.4",
        "tsx": "^4.19.4",
        "typescript": "^5.0.0"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "repository": {
        "type": "git",
        "url": "https://github.com/zilliztech/claude-context.git",
        "directory": "packages/mcp"
    },
    "license": "MIT",
    "publishConfig": {
        "access": "public"
    }
}